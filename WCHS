@media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; } }

/* schedule changes */
.btn.warnb { border-color: var(--bad); color: var(--bad); background: var(--panel); }
.btn.warnb:hover { background: rgba(192,57,43,.08); }
.item-m .btn.small { padding: 1px 8px; font-size: .75rem; }
