.aw { font-size: .85rem; margin: 0; color: var(--muted); } .aw b { color: var(--fg); }
.unsched { font-size: .85rem; display: grid; gap: 3px; }
.items { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
.item { border-top: 1px dashed var(--line); padding-top: 6px; display: grid; gap: 3px; }
