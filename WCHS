.sw.t0 { background: var(--panel); border: 1px solid var(--line); } .sw.t1 { background: #f6d6d2; } .sw.t2 { background: #fbe9b7; } .sw.t3 { background: #cfe8cf; } .sw.t4 { background: #e8ebe6; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .trk .t1 { background: #4a2420; color: #f3c3bd; } :root:not([data-theme="light"]) .trk .t2 { background: #4a3c12; color: #f5dd9a; } :root:not([data-theme="light"]) .trk .t3 { background: #23402a; color: #bfe3c0; } :root:not([data-theme="light"]) .trk .t4 { background: #262b25; color: #9aa496; } }

/* 3D */
.model-wrap { display: grid; grid-template-columns: minmax(0, 3fr) minmax(min(100%, 320px), 2fr); gap: 14px; align-items: start; }
