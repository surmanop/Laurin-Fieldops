.st0 { background: var(--green); color: #fff; } .st1 { background: #f2c94c; color: #111; } .st2 { background: var(--bad); color: #fff; } .st3 { background: var(--ink); color: var(--panel); } .st4 { border: 1px dashed var(--muted); color: var(--muted); }
.bucket summary { cursor: pointer; font-weight: 600; padding: 4px 0; } .bucket summary span { color: var(--muted); font-weight: 400; }

/* tables */
.tbl-wrap { overflow: auto; max-height: 460px; border: 1px solid var(--line); border-radius: 6px; }
