.gr .tk i.done { background: #b9c1b5; } .gr .tk i.crit { box-shadow: 0 0 0 1.5px var(--bad); }
.gr .ln { position: absolute; top: 0; bottom: 0; border-left: 2px solid var(--fg); z-index: 1; } .gr .ln.td { border-left: 2px dashed var(--bad); }

/* drawer form */
.scrim { position: fixed; inset: 0; background: rgba(10,14,10,.45); z-index: 50; display: flex; justify-content: flex-end; }
.drawer { background: var(--panel); width: min(100%, 560px); height: 100%; overflow: auto; padding: 18px; padding-top: calc(18px + env(safe-area-inset-top, 0px)); padding-bottom: calc(18px + env(safe-area-inset-bottom, 0px)); display: grid; align-content: start; gap: 14px; border-left: 4px solid var(--green); }
