}

function ZoneSchedule({ code, today, onDay }) {
  const { data, derived, day, can, setAdjust } = useApp();
  const [all, setAll] = useState(false);
  const z = code ? derived.zmap.get(code) : null;
  if (!z) return <aside className="zs"><Empty>{code ? code + ' is not a takt zone.' : 'Tap a zone to see its schedule.'}</Empty></aside>;
  const t0d = localToday();
  const ents = data.actuals.filter((e) => e.day === day && e.zone === code);
  const now = today.filter((a) => onZone(a, code));
  let items = derived.items.filter((a) => onZone(a, code));
  if (!all) items = items.filter((a) => a.finish >= t0d && !(a.category !== 'takt' && +a.pct >= 100));
  const lo = items.reduce((m, a) => (a.start < m ? a.start : m), '9999'), hi = items.reduce((m, a) => (a.finish > m ? a.finish : m), '0000');
  const t0 = parse(lo).getTime(), span = Math.max(1, parse(addDays(hi, 1)).getTime() - t0);
  const pc = (d) => (100 * (parse(d).getTime() - t0)) / span;
  const groups = [['takt', 'Master takt plan'], ['zone', 'Zone-specific (schedule)'], ['areawide', (z.area || 'Area') + '-wide (schedule)']];
  return (
    <aside className="zs">
      <h3>{z.code}</h3>
      <p className="sub">{z.rooms} · {z.level}{z.area ? ' · ' + z.area : ''} · {z.train}{z.trainPos != null ? ' #' + z.trainPos : ''}</p>
      <div className="row"><button type="button" className="btn small" onClick={onDay}>Open on Day</button><button type="button" className={'btn small' + (all ? ' on' : '')} onClick={() => setAll(!all)}>{all ? 'Showing all' : 'Show completed too'}</button></div>
      <p className="note">{fmt(day, 'long')}: {now.length ? now.length + ' scheduled' : 'nothing scheduled'}</p>
      {now.length > 0 && <ul className="items">{now.map((a) => <Item key={a.uid} a={a} entries={ents.filter((e) => isFor(e, a))} />)}</ul>}
      {items.length ? (
        <div className="gantt">
          <div className="gr hd"><div className="lb">{fmt(lo, 'shortY')} – {fmt(hi, 'shortY')}</div><div className="tk" /></div>
          {groups.map(([cat, title]) => { const list = items.filter((a) => a.category === cat).sort((a, b) => a.start.localeCompare(b.start)); if (!list.length) return null; return (
            <React.Fragment key={cat}><div className="gr gp">{title} · {list.length}</div>
              {list.map((a) => (
                <div key={a.uid} className={'gr' + (can('plan') ? ' click' : '')} onClick={can('plan') ? () => setAdjust(a) : undefined} title={`${a.name} · ${fmt(a.start)} – ${fmt(a.finish, 'shortY')}${a.shift ? ` · pushed +${a.shift}d` : ''}${can('plan') ? ' · click to mark not happening' : ''}`}>
                  <div className="lb">{a.category === 'takt' ? a.name.replace('Takt · ', '') : a.name}</div>
                  <div className="tk"><i className={(a.category !== 'takt' && +a.pct >= 100 ? 'done ' : '') + (a.critical ? 'crit' : '')} style={{ left: pc(a.start) + '%', width: Math.max(0.8, pc(addDays(a.finish, 1)) - pc(a.start)) + '%', background: a.category === 'takt' ? a.color : undefined }} />
                    {[[t0d, 'td'], [day, '']].map(([d, cl]) => d >= lo && d <= hi && <span key={cl} className={'ln ' + cl} style={{ left: pc(d) + '%' }} />)}</div>
                </div>))}
            </React.Fragment>); })}
          <p className="note">Black line = selected day · red dashed = today · grey = complete in the schedule.</p>
        </div>) : <Empty>Nothing current or upcoming. Use “Show completed too”.</Empty>}
    </aside>
  );
}

import React, { useMemo, useState } from 'react';
import { useApp } from '../store.jsx';
import { DateBar, Matrix } from '../ui/common.jsx';
import { Empty } from '../ui/parts.jsx';
import { ConstraintForm, zoneLabel } from '../ui/forms.jsx';
import { groupRows, isFor, overlaps } from '../logic/schedule.js';
import { addDays, fmt, isWorking, localToday, weekDays } from '../logic/dates.js';

export default function Lookahead() {
  const { data, derived, week, can, api, write, user } = useApp();
  const [startOnly, setStartOnly] = useState(false);
  const [openOnly, setOpenOnly] = useState(true);
  const [adding, setAdding] = useState(false);
  const weeks = Array.from({ length: 6 }, (_, i) => addDays(week, 7 * i)).map((w) => { const days = weekDays(w).filter((d) => isWorking(d, data.calendar)); return { key: w, days, label: 'Wk of ' + fmt(w) + (days.length < 5 ? ` (${days.length} days)` : ''), off: !days.length }; });
  const starts = (a, c) => a.start >= c.key && a.start <= addDays(c.key, 6);
  const pool = useMemo(() => derived.items.filter((a) => weeks.some((c) => overlaps(a, c.days) && (!startOnly || starts(a, c)))), [derived, week, startOnly]); // eslint-disable-line
  const today = localToday(), soon = addDays(today, 7);
  const open = data.constraints.filter((c) => c.status !== 'Cleared');
  const rows = (openOnly ? open : data.constraints).slice().sort((a, b) => (a.status === 'Cleared') - (b.status === 'Cleared') || a.needBy.localeCompare(b.needBy));
  const toggle = (c) => write(() => api.saveRecord('constraints', { ...c, status: c.status === 'Cleared' ? 'Open' : 'Cleared', clearedOn: c.status === 'Cleared' ? '' : today, updatedBy: user.id }), 'Constraint updated');

  return (
    <section className="screen">
      <DateBar weekly />
      <div className="card">
        <h2>Six weeks from {fmt(week, 'shortY')}</h2>
        <div className="tbl-wrap"><table className="tbl num"><thead><tr><th>Week of</th><th>Working days</th><th>Activities</th><th>Starting</th><th>Open constraints due</th></tr></thead>
          <tbody>{weeks.map((c) => { const inW = derived.items.filter((a) => overlaps(a, c.days)); return (<tr key={c.key}><td>{fmt(c.key, 'shortY')}</td><td>{c.days.length}</td><td>{inW.length}</td><td>{inW.filter((a) => starts(a, c)).length}</td><td>{open.filter((k) => k.needBy >= c.key && k.needBy <= addDays(c.key, 6)).length}</td></tr>); })}</tbody></table></div>
      </div>
      <div className="card">
        <div className="card-h"><h2>Constraints log</h2>
          <div className="row"><div className="seg"><button type="button" className={openOnly ? 'on' : ''} onClick={() => setOpenOnly(true)}>Open</button><button type="button" className={!openOnly ? 'on' : ''} onClick={() => setOpenOnly(false)}>All</button></div>{can('log') && <button type="button" className="btn primary" onClick={() => setAdding(true)}>Add constraint</button>}</div></div>
        <p className="note">{open.length} open · {open.filter((c) => c.needBy < today).length} past need-by (red) · {open.filter((c) => c.needBy >= today && c.needBy <= soon).length} due within 7 days (amber) · {data.constraints.length - open.length} cleared.</p>
        {rows.length ? (
          <div className="tbl-wrap"><table className="tbl"><thead><tr><th>Need by</th><th>Zone</th><th>Activity</th><th>Trade</th><th>Type</th><th>Constraint</th><th>Responsible</th><th>Status</th><th /></tr></thead>
            <tbody>{rows.map((c) => (
              <tr key={c.id} className={c.status === 'Cleared' ? 'clr' : c.needBy < today ? 'od' : c.needBy <= soon ? 'soon' : ''}>
                <td>{fmt(c.needBy, 'shortY')}</td><td>{zoneLabel(c.zone)}</td><td>{c.activityName || '—'}{c.activityStart && <small className="sub">Starts {fmt(c.activityStart, 'shortY')}</small>}</td><td>{c.trade}</td><td>{c.type}</td><td>{c.what}</td><td>{c.responsible}</td><td>{c.status === 'Cleared' ? 'Cleared ' + fmt(c.clearedOn) : 'Open'}</td>
                <td className="nowrap">{can('log') && <button type="button" className="btn small" onClick={() => toggle(c)}>{c.status === 'Cleared' ? 'Reopen' : 'Mark cleared'}</button>} {can('log') && (c.by === user.id || user.role === 'Owner') && <button type="button" className="link" onClick={() => write(() => api.deleteRecord('constraints', c.id), 'Constraint deleted')}>Delete</button>}</td></tr>))}</tbody></table></div>
        ) : <Empty>{openOnly ? 'No open constraints.' : 'No constraints logged yet.'}</Empty>}
      </div>
      <div className="card">
        <div className="card-h"><h2>Lookahead by zone</h2>
          <div className="seg"><button type="button" className={!startOnly ? 'on' : ''} onClick={() => setStartOnly(false)}>All activities</button><button type="button" className={startOnly ? 'on' : ''} onClick={() => setStartOnly(true)}>Starting only (make-ready)</button></div></div>
        <p className="note">Green edge = starts that week. ⚠ = open constraint on that activity.</p>
        <Matrix groups={groupRows(pool, data.zones)} cols={weeks}
          cell={(r, c) => r.items.filter((a) => overlaps(a, c.days) && (!startOnly || starts(a, c))).map((a) => { const k = open.filter((x) => isFor(x, a)).length; return { a, start: starts(a, c), tag: k ? <span className="warn">⚠ {k}</span> : null }; })}
          note={(a, c) => (starts(a, c) ? <small> starts {fmt(a.start)}</small> : null)} />
      </div>
      {adding && <ConstraintForm onClose={() => setAdding(false)} />}
    </section>
  );
}

import React, { useMemo, useState } from 'react';
import { useApp } from '../store.jsx';
import { DateBar, Matrix } from '../ui/common.jsx';
import { Empty, Kpi } from '../ui/parts.jsx';
import { CommitmentForm, zoneLabel } from '../ui/forms.jsx';
import { groupRows, isFor, overlaps, ppc, REASONS } from '../logic/schedule.js';
import { addDays, fmt, shutdownOn, weekDays } from '../logic/dates.js';

export default function Wwp() {
  const { data, derived, week, can, api, write, user } = useApp();
  const [adding, setAdding] = useState(false);
  const cols = weekDays(week).map((d) => { const s = shutdownOn(d, data.calendar); return { key: d, label: fmt(d, 'wk') + (s ? ' · ' + s.name : ''), off: !!s }; });
  const days = cols.filter((c) => !c.off).map((c) => c.key);
  const inWeek = useMemo(() => derived.items.filter((a) => overlaps(a, days)), [derived, week]); // eslint-disable-line
  const cm = data.commitments.filter((c) => c.week === week);
  const P = ppc(cm);
  const trend = Array.from({ length: 8 }, (_, i) => addDays(week, -7 * (7 - i))).map((w) => ({ w, ...ppc(data.commitments.filter((c) => c.week === w)) }));
  const misses = data.commitments.filter((c) => c.status === 'Not complete' && c.week >= trend[0].w && c.week <= week);
  const reasons = [...misses.reduce((m, c) => m.set(c.reason || 'No reason given', (m.get(c.reason || 'No reason given') || 0) + 1), new Map())].sort((a, b) => b[1] - a[1]);
  const byTrade = [...cm.reduce((m, c) => m.set(c.trade || 'No trade given', [...(m.get(c.trade || 'No trade given') || []), c]), new Map())].map(([t, rows]) => [t, ppc(rows)]);
  const ents = data.actuals.filter((e) => e.day >= week && e.day <= addDays(week, 4));
  const upd = (c, patch) => write(() => api.saveRecord('commitments', { ...c, ...patch, updatedBy: user.id, updatedAt: new Date().toISOString() }), 'Commitment updated');

  return (
    <section className="screen">
      <DateBar weekly />
      <div className="kpis">
        <Kpi v={inWeek.length} l="Activities this week (incl. takt)" />
        <Kpi v={inWeek.filter((a) => a.start >= week && a.start <= addDays(week, 6)).length} l="Starting this week" />
        <Kpi v={P.pct == null ? '—' : P.pct + '%'} l={`PPC this week (${P.done} of ${P.total})`} />
        <Kpi v={days.length} l="Working days" tone="mute" />
      </div>
      <div className="card">
        <div className="card-h"><h2>Commitments &amp; PPC</h2>{can('log') && <button type="button" className="btn primary" onClick={() => setAdding(true)}>Add commitment</button>}</div>
        <p className="note">What each trade commits to finish this week. Close each one out Friday. PPC = completed ÷ committed.</p>
        <div className="ppc">
          <div><h4>PPC, last 8 weeks</h4><div className="trend">{trend.map((t) => <div key={t.w} className={t.w === week ? 'cur' : ''} title={'Week of ' + fmt(t.w, 'shortY')}><span>{t.pct == null ? '—' : t.pct + '%'}</span><i style={{ height: t.pct == null ? 0 : Math.max(2, t.pct * 0.7) + 'px' }} /><span>{fmt(t.w)}</span></div>)}</div></div>
          <div><h4>PPC by trade, this week</h4>{byTrade.length ? byTrade.map(([t, p]) => <div key={t} className="bar"><span>{t}</span><span className="bar-t"><i style={{ width: p.pct + '%' }} /></span><span>{p.pct}% ({p.done}/{p.total})</span></div>) : <Empty>No commitments this week.</Empty>}</div>
          <div><h4>Reasons for misses, last 8 weeks</h4>{reasons.length ? reasons.map(([r, n]) => <div key={r} className="bar"><span>{r}</span><span className="bar-t bad"><i style={{ width: (100 * n) / reasons[0][1] + '%' }} /></span><span>{n}</span></div>) : <Empty>No misses recorded.</Empty>}</div>
        </div>
        {cm.length ? (
          <div className="tbl-wrap"><table className="tbl"><thead><tr><th>Zone</th><th>Commitment</th><th>Trade</th><th>By</th><th>Due</th><th>Status</th><th>Reason if missed</th><th /></tr></thead>
            <tbody>{cm.map((c) => (
              <tr key={c.id}><td>{zoneLabel(c.zone)}</td><td>{c.what}{c.activityName && c.activityName !== c.what && <small className="sub">Schedule: {c.activityName}</small>}</td><td>{c.trade}</td><td>{c.committedBy}</td><td>{c.due ? fmt(c.due, 'wk') : 'End of week'}</td>
                <td>{can('log') ? <select value={c.status} onChange={(e) => upd(c, { status: e.target.value, reason: e.target.value === 'Not complete' ? c.reason : '' })}>{['Open', 'Complete', 'Not complete'].map((s) => <option key={s}>{s}</option>)}</select> : c.status}</td>
                <td>{c.status === 'Not complete' && (can('log') ? <select value={c.reason} onChange={(e) => upd(c, { reason: e.target.value })}><option value="">Pick a reason…</option>{REASONS.map((r) => <option key={r}>{r}</option>)}</select> : c.reason)}</td>
                <td>{can('log') && (c.by === user.id || user.role === 'Owner') && <button type="button" className="link" onClick={() => write(() => api.deleteRecord('commitments', c.id), 'Commitment deleted')}>Delete</button>}</td></tr>))}</tbody></table></div>
        ) : <Empty>No commitments for this week yet.</Empty>}
      </div>
      <div className="card">
        <h2>Weekly work plan · week of {fmt(week, 'shortY')}</h2>
        <p className="note">From the master schedule and takt plan. Green edge = starts that day; red outline = critical. Tags under an item come from the field log.</p>
        <Matrix groups={groupRows(inWeek, data.zones)} cols={cols}
          cell={(r, c) => r.items.filter((a) => a.start <= c.key && a.finish >= c.key).map((a) => {
            const k = cm.filter((x) => isFor(x, a));
            return { a, start: a.start === c.key, tag: k.length ? <span className="cm">{k.every((x) => x.status === 'Complete') ? 'Committed ✓' : k.some((x) => x.status === 'Not complete') ? 'Committed ✗' : 'Committed'}</span> : null };
          })}
          entriesFor={(a, c) => ents.filter((e) => e.day === c.key && isFor(e, a))} />
      </div>
      {adding && <CommitmentForm onClose={() => setAdding(false)} />}
    </section>
  );
}

