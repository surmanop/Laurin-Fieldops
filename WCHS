              <dt>Lost days logged here</dt><dd>{c.lost || 'None'}</dd>
              <dt>Master schedule</dt><dd>{c.spct == null ? 'No matching Area activity' : `${c.area}: ${Math.round(c.spct)}% at status date`}</dd>
